# Copy to .env and fill in. .env is gitignored — never commit real values.

# REQUIRED. The server refuses to start without this.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value invalidates every issued token and logs all users out once.
JWT_SECRET=

# Postgres connection string. Without it the server starts but does not
# initialise or use the database (auth and sync will fail).
DATABASE_URL=

# Google Gemini API key. Without it the three AI endpoints return a 500
# explaining the key is missing; the rest of the app works.
GEMINI_API_KEY=

# Optional. Defaults to 3000. Railway sets this automatically.
PORT=

# --- Rate limits (all optional; sensible defaults applied when unset) ---
# AI endpoints are keyed by user id and sit behind auth.
AI_BURST_MAX=10        # AI generations per user per 15 minutes
AI_DAILY_MAX=40        # AI generations per user per 24 hours
AUTH_MAX=20            # login/register attempts per IP per 15 minutes

# Set to "development" to enable the /api/models debug route. Off in every other case.
NODE_ENV=
