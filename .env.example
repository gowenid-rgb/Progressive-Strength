# Copy to .env and fill in. .env is gitignored — never commit real values.

# REQUIRED. The server refuses to start without this.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value invalidates every issued token and logs all users out once.
JWT_SECRET=

# Postgres connection string. Without it the server starts but does not
# initialise or use the database (auth and sync will fail).
DATABASE_URL=

# AI features (generate/adjust programs, weekly review, recaps) run on the Claude that this
# machine is signed in to, through the Claude Agent SDK. There is no API key. Set to "claude" on a
# machine signed in to Claude; leave unset anywhere else and the AI endpoints answer with a
# clear "AI features are off" error instead of hanging.
AI_PROVIDER=
# Which Claude model to use. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=

# Optional. Defaults to 3000. Railway sets this automatically.
PORT=

# --- Rate limits (all optional; sensible defaults applied when unset) ---
# AI endpoints are keyed by user id and sit behind auth.
AI_BURST_MAX=10        # AI generations per user per 15 minutes (these count against the Claude plan)
AI_DAILY_MAX=40        # AI generations per user per 24 hours (these count against the Claude plan)
AUTH_MAX=20            # login/register attempts per IP per 15 minutes

NODE_ENV=

# --- Cloudflare Access sign-in (optional; off unless BOTH are set) ---
# When the app sits behind Cloudflare Access, the visitor's Access token can sign them in with
# no app password. The token is verified against Cloudflare's published keys; headers alone are
# never trusted. In this mode sign-up is disabled and password login stays as a fallback.
# Your Access team domain, e.g. yourteam.cloudflareaccess.com (no https://).
CF_ACCESS_TEAM_DOMAIN=
# The Access application's Audience (AUD) tag, from the application's settings in Zero Trust.
CF_ACCESS_AUD=
